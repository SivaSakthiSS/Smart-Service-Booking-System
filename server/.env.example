# ==============================================================
# Smart Service Hub — Server Environment Configuration Template
# Copy this file to `server/.env` for local development.
# NEVER commit real credentials or production secrets to version control.
# ==============================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development

# Database Connection
# In local development: mongodb://127.0.0.1:27017/smart_service_hub
# In MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smart_service_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_service_hub

# Allowed Client Origin (CORS & CSRF Origin Verification)
CLIENT_URL=http://localhost:5173

# Server-Side Session Security
# Required in production: Minimum 32-character high-entropy secret string
# Generate on Linux/macOS with: openssl rand -hex 32
# Generate on Windows with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=smart_service_hub_dev_session_secret_32chars_minimum_ok

# Safe Local Administrator Provisioning (Used by `npm run seed:admin`)
# Never expose production admin credentials in code repositories.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@smartservicehub.local
ADMIN_PASSWORD=Admin@SecurePass2026!
