# ==============================================================
# Smart Service Hub — Monorepo Root Environment Reference
# Copy the respective .env.example files into:
#   - server/.env
#   - client/.env
# ==============================================================

# --- SERVER SETTINGS (stored in server/.env) ---
# PORT=5000
# NODE_ENV=development
# MONGODB_URI=mongodb://127.0.0.1:27017/smart_service_hub
# CLIENT_URL=http://localhost:5173
# SESSION_SECRET=your_minimum_32_char_random_secret_string
# ADMIN_EMAIL=admin@smartservicehub.local
# ADMIN_PASSWORD=Admin@SecurePass2026!

# --- CLIENT SETTINGS (stored in client/.env) ---
# VITE_API_BASE_URL=http://localhost:5000/api
